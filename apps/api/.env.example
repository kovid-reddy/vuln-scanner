# apps/api/.env.example
#
# Copy this file to .env for local development:
#   cp apps/api/.env.example apps/api/.env
#
# NEVER commit .env with real credentials.
# Production values are configured in the Render dashboard — see render.yaml.

# ── Database ──────────────────────────────────────────────────────────────────
# Local: a PostgreSQL database running on your machine or in Docker
# Production: set to your Supabase connection string in the Render dashboard
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vulnscanner"

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local: a Redis instance running on your machine or in Docker
# Production: auto-injected by Render from the internal Redis service
REDIS_URL="redis://localhost:6379"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local: Next.js dev server URL
# Production: set to your Vercel deployment URL in the Render dashboard
FRONTEND_URL="http://localhost:3000"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
